# Server
PORT=3000
PUBLIC_BASE_URL=https://your-railway-app.up.railway.app
MAKE_WEBHOOK_SECRET=change-me

# Optional OpenAI fallback for translations not present in Labels_13_talen.xlsx.
# Unknown/researched translations are always rendered in red and logged for review.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_ENABLE_WEB_SEARCH=true

# Local fallback paths for development. In production, prefer SharePoint paths below.
LOCAL_TRANSLATION_DB_PATH=C:\Users\y.caous\Downloads\QA proces\Labels_13_talen.xlsx
LOCAL_TEMPLATE_NORMAL_PATH=C:\Users\y.caous\Downloads\QA proces\BI09-sjabloon-etiket-de-nl-fr-se-fi-dk-it-gb-cz-hu-pl-es-sk-versie- 040825.docx
LOCAL_TEMPLATE_FROZEN_PATH=C:\Users\y.caous\Downloads\QA proces\BI13 Sjabloon Diepvries etiket DE; NL; FR; SE; FI, DK, IT; GB; CZ; HU; PL; ES; SK versie 270125.docx
LOCAL_TEMPLATE_FISHERY_FROZEN_PATH=C:\Users\y.caous\Downloads\QA proces\BI53 Sjabloon Diepvries Visserijproduct etiket DE; NL; FR; SE; FI, IT; GB; CZ; HU; PL; ES; SK versie 270125.docx

# SharePoint / Microsoft Graph app-only access.
# Create an Entra ID app registration with Sites.ReadWrite.All or a narrower Sites.Selected setup.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# Optional: use a Microsoft Teams channel "Bestanden/Gedeeld" folder as the base folder.
# If both are set, SP_* paths below are relative to that channel folder.
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=

# File layout. Without TEAMS_* these are paths inside the SharePoint document library drive.
# With TEAMS_* these are paths relative to the Teams channel files folder.
SP_TEMPLATE_NORMAL_PATH=Templates/BI09-sjabloon-etiket-de-nl-fr-se-fi-dk-it-gb-cz-hu-pl-es-sk-versie- 040825.docx
SP_TEMPLATE_FROZEN_PATH=Templates/BI13 Sjabloon Diepvries etiket DE; NL; FR; SE; FI, DK, IT; GB; CZ; HU; PL; ES; SK versie 270125.docx
SP_TEMPLATE_FISHERY_FROZEN_PATH=Templates/BI53 Sjabloon Diepvries Visserijproduct etiket DE; NL; FR; SE; FI, IT; GB; CZ; HU; PL; ES; SK versie 270125.docx
SP_TRANSLATION_DB_PATH=Database/Labels_13_talen.xlsx
SP_OUTPUT_FOLDER=Output
SP_RUN_LOG_PATH=Run log/label-agent-runs.xlsx
